{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rendulic-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
